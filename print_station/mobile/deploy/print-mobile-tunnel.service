[Unit]
Description=Read-only Print Station mobile tunnel
After=network-online.target print-station.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -i %h/.ssh/printer_mobile_ed25519 -R 127.0.0.1:8080:127.0.0.1:8080 printer-mobile@203.0.113.10
Restart=always
RestartSec=10
NoNewPrivileges=yes

[Install]
WantedBy=default.target
