#!/bin/bash
# Droplet half of the print station remote switch. Installed as /usr/local/sbin/printer-remote-ctl;
# run as root by the print station host over ssh, and every minute by /etc/cron.d/printer-remote (expire).
#   on <expires-epoch> | allow <ip|any> | extend <expires-epoch> | off | expire | lastjump | status
set -euo pipefail
D=/etc/printer-remote
CONF=/etc/apache2/printer-remote/printer.conf
mkdir -p "$D" "$(dirname "$CONF")"

reload() {
    if apache2ctl configtest >/dev/null 2>&1; then systemctl reload apache2
    else rm -f "$CONF" "$D/ips" "$D/expires"; systemctl reload apache2; echo "bad config, access left off" >&2; exit 1; fi
}

write_conf() {
    local req="Require all denied"
    [ -s "$D/ips" ] && req="Require ip $(tr '\n' ' ' < "$D/ips")"
    grep -qxF any "$D/ips" 2>/dev/null && req="Require all granted"   # any address; the password still applies
    cat > "$CONF" <<CONF
# Generated by printer-remote-ctl; deleted when remote access turns off.
RedirectMatch ^/printer\$ /printer/
<Location /printer/>
    ProxyPass http://127.0.0.1:8079/ flushpackets=on
    ProxyPassReverse http://127.0.0.1:8079/
    RequestHeader set X-Print-Remote 1
    AuthType Basic
    AuthName "Print station"
    AuthUserFile /etc/apache2/.htpasswd-printer
    <RequireAll>
        $req
        Require valid-user
    </RequireAll>
</Location>
CONF
    reload
}

off() { rm -f "$CONF" "$D/ips" "$D/expires" /var/lib/printer-status/snapshot.json; reload; }

case "${1:-}" in
    on|extend)
        [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "need expiry epoch" >&2; exit 2; }
        echo "$2" > "$D/expires"
        if [ "$1" = on ]; then : > "$D/ips"; touch "$D/session_started"; fi
        write_conf ;;
    allow)
        ip="${2:-}"
        [ "$ip" = any ] || python3 -c 'import ipaddress,sys; ipaddress.ip_address(sys.argv[1])' "$ip" 2>/dev/null || { echo "bad ip" >&2; exit 2; }
        [ -f "$D/expires" ] || { echo "remote access is off" >&2; exit 1; }
        grep -qxF "$ip" "$D/ips" 2>/dev/null || echo "$ip" >> "$D/ips"; write_conf ;;
    off) off ;;
    expire)
        # expired, or config left behind without an expiry: close
        if { [ -f "$D/expires" ] && [ "$(date +%s)" -ge "$(cat "$D/expires")" ]; } || { [ -f "$CONF" ] && [ ! -f "$D/expires" ]; }; then off; fi ;;
    lastjump)
        journalctl --since -12h -o cat 2>/dev/null | grep -oP 'Accepted publickey for jump from \K[0-9a-fA-F.:]+' | tail -1 ;;
    status)
        if [ -f "$D/expires" ]; then echo "on until $(date -d @"$(cat "$D/expires")")"; echo "ips: $(tr '\n' ' ' < "$D/ips")"
        else echo off; fi ;;
    *) echo "usage: $0 on|allow|extend|off|expire|lastjump|status" >&2; exit 2 ;;
esac
